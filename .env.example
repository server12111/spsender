# Папка для всех сохраняемых данных: база, медиа и журнал.
# На хостингах, где между перезапусками сохраняется только один каталог
# (например, Bothost — /app/data), укажите здесь этот каталог, иначе данные
# потеряются при рестарте. Если не задано — берётся /app/data при его наличии,
# иначе ./data. DATABASE_PATH ниже переопределяет расположение только базы.
DATA_DIR=
# SQLite, сервер БД не требуется. Пусто — база ложится в <DATA_DIR>/fe_autosender.sqlite3.
DATABASE_PATH=
MODE=dry-run
BOT_TOKEN=
ADMIN_IDS=
TIMEZONE=Europe/Kyiv
# python -m app keygen (сохранить результат; без него старые сессии не расшифровать)
SESSION_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
WORKER_INTERVAL=2
JOIN_PAUSE_SECONDS=75

# Начальные значения очереди. После первой инициализации изменяются кнопками
# «Настройки» и сохраняются в SQLite; значения БД имеют приоритет над .env.
BATCH_SIZE=32
CONCURRENCY=4
BATCH_INTERVAL=0.25
PLANNING_BATCH_SIZE=64
MAX_PENDING_JOBS=10000
MAX_RETRIES=3
RETRY_BASE=5
RETRY_MAX=300

# Технические ограничения процесса (применяются после перезапуска).
SQLITE_BUSY_MS=250
CONNECTION_BATCH_SIZE=8
INCOMING_QUEUE_SIZE=1000
ENTITY_CACHE_LIMIT=1000
