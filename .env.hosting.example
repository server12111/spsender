# Bothost: постоянное хранилище, сохраняемое между пересборками.
DATA_DIR=/app/data
MODE=live
BOT_TOKEN=
ADMIN_IDS=
# Сохраните действующий ключ. Не генерируйте новый при пересборке.
SESSION_KEY=
TIMEZONE=Europe/Kyiv
# Прежняя пара API остаётся при первом обновлении; новые добавляются через пул.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
